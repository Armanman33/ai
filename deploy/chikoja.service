# Systemd Service Unit for چی‌کجا (ChikojA) on Ubuntu 24.04 LTS
# Install:
#   sudo cp /opt/chikoja/deploy/chikoja.service /etc/systemd/system/chikoja.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now chikoja.service

[Unit]
Description=ChikojA (چی‌کجا) Tehran Lost & Found Web Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chikoja
Group=chikoja
WorkingDirectory=/opt/chikoja
EnvironmentFile=/opt/chikoja/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/chikoja/server/dist/index.js
Restart=always
RestartSec=5
TimeoutStopSec=15

# OS-level security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chikoja/storage
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chikoja

[Install]
WantedBy=multi-user.target
