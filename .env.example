# ==============================================================================
# چی‌کجا (ChikojA) — Environment Configuration Template
# کپی کنید به .env و مقادیر واقعی محیط Production را جایگزین کنید.
# هرگز فایل .env واقعی یا کلیدهای محرمانه را در GitHub قرار ندهید!
# ==============================================================================

# --- Runtime Environment ---
# مقادیر مجاز: development | production
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# وقتی پشت Nginx Reverse Proxy اجرا می‌شود، مقدار true بگذارید تا IP واقعی و HTTPS تشخیص داده شود
TRUST_PROXY=true

# --- Public Domain & SEO ---
# دامنه اصلی HTTPS سایت (بدون اسلش انتهایی) — برای Canonical، Open Graph، robots.txt و sitemap.xml
PUBLIC_SITE_URL=https://chikoja.ir

# در محیط Production روی false بگذارید تا X-Frame-Options: SAMEORIGIN فعال باشد
# فقط در محیط‌های پیش‌نمایش iframe (مثل Arena Preview) روی true بگذارید
ALLOW_IFRAME_EMBEDDING=false

# --- Cryptography & Session Secret (الزامی در Production) ---
# حداقل ۳۲ کاراکتر تصادفی قوی تولید کنید:
#   openssl rand -hex 48
APP_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_HEX_SECRET

# --- Storage & SQLite Database Paths ---
# مسیر امن خارج از public web root با مجوز دسترسی فقط برای کاربر سرویس Node.js (chmod 750)
STORAGE_DIR=/var/lib/chikoja/storage
DB_PATH=/var/lib/chikoja/storage/ChikojA.db

# --- Demo Data Isolation ---
# در محیط Production باید حتماً false باشد تا داده‌های نمونه وارد محیط واقعی نشوند
SEED_DEMO_DATA=false

# --- Automatic Retention & Disk Cleanup (جلوگیری از پر شدن دیسک) ---
# چند روز پس از انقضای آگهی ۳ روزه (فرصت ثبت مجدد)، آگهی و تصاویر آن به‌صورت خودکار حذف شوند
EXPIRED_ITEM_PURGE_DAYS=7
# چند روز پس از حذف آگهی (تصاویر همان لحظه پاک می‌شوند)، رکورد دیتابیس حذف شود
REMOVED_ITEM_PURGE_DAYS=1
# چند روز پس از تکمیل تحویل، تصاویر و رکورد بایگانی‌شده پاک شود (برای حفظ دسترسی موقت به رسید)
DELIVERED_ITEM_PURGE_DAYS=30
# چند روز پس از انقضای هشدار ۵ روزه، رکورد هشدار به‌صورت خودکار پاک شود
EXPIRED_ALERT_PURGE_DAYS=7
# مدت نگهداری لاگ پیامک، اعلان‌های خوانده‌شده و تاریخچه ممیزی بدون والد (روز)
LOG_RETENTION_DAYS=30
# حداقل عمر فایل‌های یتیم (بدون رکورد در دیتابیس) پیش از پاک‌سازی خودکار (دقیقه)
ORPHAN_FILE_GRACE_MINUTES=10

# --- SMS Provider Configuration ---
# مقادیر مجاز: kavenegar (واقعی) | sandbox (فقط برای توسعه/آزمایش)
SMS_PROVIDER=kavenegar
# کلید API واقعی کاوه‌نگار (در صورت استفاده از SMS_PROVIDER=kavenegar الزامی است)
KAVENEGAR_API_KEY=
# در Production کد OTP هرگز نباید در پاسخ HTTP برگردد؛ فقط برای تست داخلی موقت روی true بگذارید
ALLOW_SANDBOX_SMS_IN_PROD=false
# فاصله زمانی حداقل بین دو درخواست OTP برای یک شماره (ثانیه)
OTP_COOLDOWN_SECONDS=45

# --- Google Search Console Verification (اختیاری — پس از ثبت دامنه تنظیم شود) ---
# روش ۱ (Meta Tag): فقط مقدار content تگ google-site-verification
GOOGLE_SITE_VERIFICATION=
# روش ۲ (HTML File): نام دقیق فایل ارائه‌شده توسط گوگل مثل google1234567890abcdef.html
GOOGLE_SITE_VERIFICATION_FILE=

# --- Frontend Build-Time Variables (مخصوص client هنگام npm run build) ---
# آدرس سرور تایل نقشه (در صورت اتصال به سرویس نقشه رسمی داخل ایران مثل نشان/بلد/سرور اختصاصی OSM)
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
